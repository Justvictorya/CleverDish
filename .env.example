# Copy to .env and fill in real values. Never commit .env (it is gitignored).

# GEMINI_API_KEY — Google AI Studio key (https://aistudio.google.com/apikey).
# Enables real Gemini output for inflation swap, pantry scan and meal plating.
# Leave blank to run on the built-in local fallback engines.
GEMINI_API_KEY=

# APP_URL — public origin of the deployed app.
APP_URL="https://cleverdish.app"

# PORT — HTTP port (default 3000).
PORT=3000

# DATA_DIR — where price samples, overrides, auth tokens and plate photos persist.
# Point this at a mounted persistent disk in production. Defaults to ./data.
# DATA_DIR="/data"

# NODE_ENV must be "production" for the server to serve the built assets in ./dist.
# `npm start` sets this automatically.
NODE_ENV=production