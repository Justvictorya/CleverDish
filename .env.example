# GEMINI_API_KEY: Required for Gemini AI calls (inflation swap, pantry scan, meal visual).
# Without it, the app uses deterministic local fallback engines instead.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted. Used for meta/OG tags and API references.
APP_URL="https://cleverdish.onrender.com"

# PORT: HTTP port the server listens on (default 3000).
PORT=3000

# DATA_DIR: Where price samples, overrides, auth tokens and uploaded plate photos persist.
# MUST point to a persistent disk in production (Render/Railway volume); default is ./data
# DATA_DIR="data"

# NODE_ENV=production must be set for the server to serve the built assets in ./dist
# (set automatically by `npm start` via the start script).
NODE_ENV=production