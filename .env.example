# Copy to .env and fill in real values. Never commit .env (it is gitignored).

# GEMINI_API_KEY — Google AI Studio key (https://aistudio.google.com/apikey).
# Enables real Gemini output for inflation swap, pantry scan and meal plating.
# Leave blank to run on the built-in local fallback engines.
GEMINI_API_KEY=

# AI_BUDGET_MS — wall-clock ceiling in milliseconds for the Gemini model chain
# (gemini-3.8-flash -> gemini-3.6-flash -> gemini-2.5-flash) before the app
# answers with its built-in country-aware fallback engines instead.
# Gemini occasionally returns 503 UNAVAILABLE ("high demand"); this keeps a tap
# from sitting on a spinner. Lower it for snappier replies, raise it to give the
# model more chances to answer. Default 12000.
# AI_BUDGET_MS=12000

# Meal-time push reminders (breakfast / lunch / dinner).
#
# Generate ONE pair of keys and reuse them everywhere:
#   npx web-push generate-vapid-keys
# The public key is handed to browsers; the private key signs every push and
# must stay server-side. Treat the pair as one credential: changing either
# invalidates every browser subscription, and users must re-enable reminders.
#
# In production set these on the host rather than in the repo. If they are
# absent the server generates a pair under DATA_DIR instead, which is fine for
# local runs but silently breaks subscriptions whenever DATA_DIR is wiped.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:support@cleverdish.app"

# APP_URL — public origin of the deployed app.
APP_URL="https://cleverdish.app"

# PORT — HTTP port (default 3000).
PORT=3000

# DATA_DIR — where price samples, overrides, auth tokens and plate photos persist.
# Point this at a mounted persistent disk in production. Defaults to ./data.
# DATA_DIR="/data"

# NODE_ENV must be "production" for the server to serve the built assets in ./dist.
# `npm start` sets this automatically.
NODE_ENV=production